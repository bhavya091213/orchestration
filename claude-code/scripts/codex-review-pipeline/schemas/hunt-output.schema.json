{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "next_steps"],
  "properties": {
    "verdict": { "type": "string", "enum": ["approve", "needs-attention"] },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "complexity", "category", "title", "body", "file", "line_start", "line_end", "confidence", "recommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{2,3}$" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "complexity": { "type": "string", "enum": ["simple", "complex"] },
          "category": { "type": "string", "enum": ["correctness", "security", "data-integrity", "concurrency", "error-handling", "regression", "missing-test", "performance", "other"] },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "recommendation": { "type": "string" }
        }
      }
    },
    "next_steps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
